	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                                
                                ;FLOPPY DISK SETUP CONSTANTS
                                ;
                                ;MINI DRIVES CONSTANTS
  07FF                          MIBYT0	EQU	2047	;BYTES TRACK0 SODE0(16*128)-1
  0FFF                          MIBYT1	EQU	4095	;BYTES TRACK0 SIDE1(16*256)-1
                                ;
                                ;MAXI DRIVES CONSTANTS
                                ;
  0CFF                          MXBYT0	EQU	3327	;BYTES TRACK0 SIDE0(26*128)-1 
  19FF                          MXBYT1	EQU	6655	;BYTES TRACK0 SIDE1(26*256)-1
                                ;
                                ;MISCELLENEOUS DISK CONSTANTS
                                ;
  0042                          DUALC	EQU	042H	;DUAL DENSITY READ COMMAND
  00FF                          DUADTL	EQU	0FFH	;DTL FOR DUAL DENSITY
  000E                          DUAGPL	EQU	00EH	;GAB3 FOR DUAL DENSITY
  0004                          DR0H1	EQU	004H	;DRIVE0 HEAD1
  0001                          BDSEC	EQU	001H	;N FOR DUAL DENSITY
  0010                          MINEOT	EQU	010H	;MINIDRIVES EOT=16
                                ;
                                ;
                                ;READ DISK COMMAND BUFFER
  A517    02                    COMBUF:	DB 02H		;READ TRACK COMMAND(SINGLE DENSITY)
  A518    00                    	DB 00H		;DRIVE0/HEAD0
  A519                          CURID:			;CURRENT FLOPPY ID INFO
  A519    00                    	DB 00H		;CYLINDER NUMBER
  A51A    00                    	DB 00H		;HEAD ADDRESS
  A51B    01                    	DB 01H		;RECORD NUMBER
  A51C    00                    	DB 00H		;RECORD LENGTH
                                        
  A51D    1A                    	DB 1AH		;EOT
  A51E    07                    	DB 07H		;GAB3
  A51F    80                    	DB 80H		;DTL
                                    
  A520    0CFF                  TRBYT:	DW MXBYT0	;NUMBER OF BYTES TO TRANSFER DURING DMA FROM ONE
                                			;TRACK(DEFAULT MAXI-DRIVE TRACK0 SIDE0)
                                
  A522                          FDCINI:			;FDC SPECIFY COMMAND BUFFER
  A522    03                    	DB 3		;NUMBER OF COMMANDS
  A523    03                    	DB 3		;SPECIFY COMMAND
  A524    DF                    	DB 0DFH		;SRT=3MS HUT=240MS
  A525    28                    	DB 028H		;HLT=40MS DMAMODE
                                
                                
                                PAGE
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                
  A526                          STPDMA:                 ;PROCEDURE SET_UP_DMA
                                                        ;READING FROM DISK TO MEMORY
                                                        ;CHANNEL ADDRESS IN C REGISTER
                                                        ;DMA MEMORY ADDRESS IN HL REGISTER
                                                        ;NUMBER OF BYTES TO TRANSFER IN DE REGISTER
                                                        ;SETMASK IN A REGISTER
  A526    F3                            DI              ;BEGIN
  A527    D3 FA                         OUT (SMSK),A    ;SET CHANNEL MASK
  A529    D3 FC                         OUT (CLBP),A    ;CLAR BYTE POINTER
  A52B    ED 69                         OUT (C),L       ;SET LOW ADDRESS
  A52D    ED 61                         OUT (C),H       ;SET HIGH ADDRESS
  A52F    0C                            INC C           ;
  A530    ED 59                         OUT (C),E       ;SET LOW WORDCOUNT
  A532    ED 51                         OUT (C),D       ;SET HIGH WORDCOUNT
  A534    CB 97                         RES 2,A         ;CLEAR MASK BIT
  A536    D3 FA                         OUT (SMSK),A    ;ENABLE DMA
  A538    FB                            EI              ;
  A539    C9                            RET             ;END
                                
                                
                                PAGE
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                                
                                ;*****************************************************************************         	
                                ;*
                                ;* INTERRUPT SERVICE RUTINES:
                                ;*
                                ;*****************************************************************************
                                ;
  A53A    FB                    DUMINT:	EI 		;PROCEDURE DUMMY_INTERRUPT
  A53B    ED 4D                 	RETI		;
                                ;
                                ;
                                ;
  A53D    08                    KBINT:	EX AF,AF'	;PROCEDURE KEYBOARD_INTERRUPT
  A53E    DB 10                 	IN A,(KEYDAT)	;BEGIN
  A540    E6 5F                 	AND 05FH	;  (A):=INCHAR("MASK LOWER CASE LETTERS TO UPPER")
  A542    FE 46                 	CP 'F'   	;  IF FLOPPY_BOOT_CHAR THEN
  A544    20 03                 	JR NZ,T22	;
  A546    32 A5BC               	LD (FLBFLG),A	;  FLOPPY_BOOT:=TRUE
  A549    08                    T22:	EX AF,AF'       ;
  A54A    FB                            EI              ;
  A54B    ED 4D                         RETI            ;END
                                ;
                                ;
  A54D    08                    FLPINT:	EX AF,AF'	;PROCEDURE FLOPPY_INTERRUPT
  A54E    D9                    	EXX		;BEGIN
  A54F    3E FF                 	LD A,0FFH	;  FLOPPY_FLAG:=FALSE
  A551    32 A5BD               	LD (FL_FLG),A	;
  A554    3E 05                 	LD A,5		;  "FDC CRITICAL TIMING"
  A556    3D                    TIMFLI:	DEC A		;
  A557    20 FD                 	JR NZ,TIMFLI	;
  A559    DB 04                 	IN A,(FDC)	;
  A55B    E6 10                 	AND 10H		; "NON DMA MODE TEST"
  A55D    20 05                 	JR NZ,RRES	;
  A55F    CD A442               	CALL FLO6	; SENSE INTERRUPT STATUS
  A562    18 03                 	JR FEXIT	;
  A564    CD A48A               RRES:	CALL RSULT	; READ RESULT
  A567    08                    FEXIT:	EX AF,AF'	;
  A568    D9                    	EXX		;
  A569    FB                    	EI		;
  A56A    ED 4D                 	RETI		;END
                                ;
                                ;
                                ;
  A56C    08                    DISINT:	EX AF,AF'	;PROCEDURE DISPLAY_INTERRUPT
  A56D    DB 01                 	IN A,(CRTCOM)	;REMOVE INTERRUPT BY READING STATUS
  A56F    3A A5C2                       LD A,(TIMER)     ;IF TIMER <> 0 THEN TIMER=TIMER-1
  A572    B7                            OR A            ;
  A573    28 04                         JR Z,DISIN1     ;
  A575    3D                            DEC A           ;
  A576    32 A5C2                       LD (TIMER),A  ;
  A579    08                    DISIN1: EX AF,AF'       ;
  A57A    FB                    	EI		;
  A57B    ED 4D                 	RETI		;
                                PAGE
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


                                
  A57D                          ERR:			;PROCEDURE ERROR_ABORT        
  A57D    11 B0C0               	LD DE,DSPSTR+160;START WRITING IN DISPLAY BUFFER LINE 2
  A580    CD A5AC                       CALL MESSWR     ;WRITE MASSAGE
  A583    D3 1C                 FIN:	OUT (BIB),A	;  PROMT FOR ABORT TO CRT
  A585    CD A4C6               	CALL FDSTOP	;  STOP_MINI_MOTOR
  A588    18 FE                 ALOOP:	JR ALOOP        ; ABORT
                                
                                
  A58A    3A A5BE               WRNUM:  LD A,(HSTTRK)    ; WRITE TRACKNUMBER 
  A58D    21 A62C                       LD HL,MESS2+2   ; UNDER FORMATTING
  A590    36 30                         LD (HL),'0'     ;
  A592    2B                            DEC HL          ;
  A593    36 30                         LD (HL),'0'     ;
  A595    2B                            DEC HL          ;
  A596    36 30                         LD (HL),'0'     ;
  A598    06 64                         LD B,100        ;
  A59A    CD A5B4                       CALL COMMON     ; CHECK AND MINUS 100
  A59D    23                            INC HL          ;
  A59E    06 0A                         LD B,10         ;
  A5A0    CD A5B4                       CALL COMMON     ; CHECK AND MINUS 10
  A5A3    23                            INC HL          ;
  A5A4    B6                            OR (HL)         ;
  A5A5    77                            LD (HL),A       ; SET 1
  A5A6    21 A618                       LD HL,MESS1     ; WRITE 'FORMATTING .....'
  A5A9    11 B070                       LD DE,DSPSTR+80 ; IN LINE 2
  A5AC    7E                    MESSWR: LD A,(HL)       ; WHILE (HL) <> 0 DO
  A5AD    B7                            OR A            ;
  A5AE    C8                            RET Z           ;
  A5AF    12                            LD (DE),A       ; WRITE_CHAR
  A5B0    13                            INC DE          ;
  A5B1    23                            INC HL          ;
  A5B2    18 F8                         JR MESSWR       ;
  A5B4    B8                    COMMON: CP B            ; IF A>B THEN
  A5B5    D8                            RET C           ;
  A5B6    34                            INC (HL)        ; INC TEXT
  A5B7    90                            SUB B           ; A=A-B
  A5B8    18 FA                         JR COMMON       ; ENDIF
                                ;
                                PAGE
