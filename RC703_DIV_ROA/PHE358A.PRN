                                ;
                                ;CRT COLOR DECRIPTION
  00C1                          COL	EQU	193	;COLOR ATTRIBUTE
  0000                          BACK	EQU	000	;SELECT BACKGROUND
  0002                          FORG	EQU	002	;SELECT FORGROUND
  0004                          BLUE	EQU	004	;BLUE CANON
  0008                          RED	EQU	008	;RED CANON
  0010                          GREEN	EQU	016	;GREEN CANON
